---
import Layout from '../layouts/Layout.astro';
import Nav from '../components/Nav.svelte';
import Hero from '../components/Hero.svelte';
import About from '../components/About.svelte';
import Skills from '../components/Skills.svelte';
import Projects from '../components/Projects.svelte'
import Honors from '../components/Honors.svelte';
import Education from '../components/Education.svelte';
import Contact from '../components/Contact.svelte';
import Footer from '../components/Footer.svelte';
import TerminalDock from '../components/TerminalDock.svelte';
import GitGraph from '../components/GitGraph.svelte';
import HoverPreview from '../components/HoverPreview.svelte';

import { getCollection, render } from 'astro:content';

const rawProjects = await getCollection('projects');
const projects = await Promise.all(
  rawProjects.map(async (project) => {
    const { Content } = await render(project);
    return { ...project.data, body: project.body };
  })
);

const rawAwards = await getCollection('awards')
const awards = await Promise.all(
  rawAwards.map(async (a) => {
    const { Content } = await render(a);
    return { ...a.data, body: a.body };
  })
);

const rawEducation = await getCollection('education');
const educationList = await Promise.all(
  rawEducation.map(async (edu) => {
    const { Content } = await render(edu);
    return { ...edu.data, body: edu.body };
  })
);
---

<Layout title="Gabriel Paiva - Backend & Self-Hosted Infrastructure">
  <Nav client:load />
  <Hero client:load />
  <About />
  <Skills />
  <Projects {projects}/>
  <Honors {awards}/>
  <Education {educationList}/>
  <Contact />
  <Footer />

  <TerminalDock client:load />
  <GitGraph client:load />
  <HoverPreview client:load />
</Layout>