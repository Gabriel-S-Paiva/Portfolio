---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { statSync } from 'node:fs';
import { join } from 'node:path';

// A downloadable document shown as a card with its cover. `href` is a path under /public.
// The file size is read at build time so it never goes stale.
interface Props {
  cover: ImageMetadata;
  coverAlt: string;
  title: string;
  description: string;
  href: string;
  pages?: number;
}
const { cover, coverAlt, title, description, href, pages } = Astro.props;

const bytes = statSync(join(process.cwd(), 'public', href)).size;
const size = bytes >= 1024 * 1024 ? `${Math.round(bytes / 1024 / 1024)} MB` : `${Math.round(bytes / 1024)} KB`;
const meta = ['PDF', pages ? `${pages} pages` : null, size].filter(Boolean).join(', ');
---

<a class="doc" href={href} target="_blank" rel="noopener">
  <div class="cover">
    <Image src={cover} alt={coverAlt} widths={[480, 800, 1200]} sizes="(min-width: 900px) 420px, 100vw" loading="lazy" />
  </div>
  <div class="text">
    <h3>{title}</h3>
    <p>{description}</p>
    <p class="meta">{meta}</p>
    <span class="cta">Open the manual →</span>
  </div>
</a>

<style>
  .doc {
    display: grid;
    grid-template-columns: 1fr;
    margin-block: 2rem;
    background: var(--surface);
    border: 1px solid var(--line);
    border-radius: 12px;
    overflow: clip;
    text-decoration: none;
    transition: border-color .2s ease, transform .2s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .doc:hover, .doc:focus-visible { border-color: var(--brass); transform: translateY(-2px); }
  .doc:focus-visible { outline: 2px solid var(--brass); outline-offset: 2px; }
  .doc:active { transform: translateY(0) scale(.995); }
  .cover { overflow: clip; background: var(--surface-2); }
  .cover :global(img) {
    display: block; width: 100%; height: auto; aspect-ratio: 16 / 9; object-fit: cover;
    transition: scale .4s cubic-bezier(0.16, 1, 0.3, 1);
  }
  .doc:hover .cover :global(img) { scale: 1.03; }
  .text { padding: 1.25rem 1.5rem 1.5rem; display: flex; flex-direction: column; gap: .5rem; }
  h3 { margin: 0; color: var(--text); font-size: 1.15rem; font-weight: 600; }
  p { margin: 0; color: var(--dim); font-size: 14.5px; line-height: 1.6; }
  .meta { font-family: var(--font-mono); font-size: 12px; }
  .cta { margin-top: .5rem; font-family: var(--font-mono); font-size: 13px; color: var(--brass); }

  @media (min-width: 768px) {
    .doc { grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr); align-items: stretch; }
    .cover :global(img) { height: 100%; }
    .text { justify-content: center; padding: 1.5rem; }
  }
  @media (prefers-reduced-motion: reduce) {
    .doc, .cover :global(img) { transition: none; }
    .doc:hover, .doc:focus-visible { transform: none; }
    .doc:hover .cover :global(img) { scale: 1; }
  }
</style>
