---
import Window from './Window.astro';

// The whole home server: gateway in front, one Compose project per site. No addresses or ports on purpose.
interface Props {
  caption?: string;
}
const { caption } = Astro.props;
---

<Window title="home server / what runs where" caption={caption}>
  <div class="map" role="img" aria-label="A browser request reaches the gateway Caddy, which routes by hostname. Portfolio requests go to an nginx container serving the static Astro build. Cloud requests go to the Cloud project's own Caddy, which sends /api to the Go backend with SQLite and serves everything else from the static frontend. A GitHub Actions runner on the same machine rebuilds both projects.">
    <div class="node edge"><b>Browser</b><small>home network</small></div>
    <div class="arrow" aria-hidden="true">→</div>
    <div class="node"><b>gateway Caddy</b><small>routes by hostname</small></div>

    <div class="projects" aria-hidden="true">
      <div class="project">
        <span class="tag">portfolio / compose project</span>
        <div class="node accent"><b>nginx</b><small>static Astro build</small></div>
      </div>
      <div class="project">
        <span class="tag">cloud / compose project</span>
        <div class="node"><b>caddy</b><small>the project's own</small></div>
        <div class="split">
          <div><span class="route">/api</span><div class="node accent"><b>Go backend</b><small>SQLite + volume</small></div></div>
          <div><span class="route">everything else</span><div class="node accent"><b>static frontend</b><small>SvelteKit build</small></div></div>
        </div>
      </div>
    </div>

    <div class="runner" aria-hidden="true">
      <span class="route">same machine</span>
      <div class="node edge"><b>GitHub Actions runner</b><small>pulls, rebuilds and restarts both projects</small></div>
    </div>
  </div>
</Window>

<style>
  .map { display: grid; gap: .5rem; padding: 1.25rem 1rem; }
  .node { border: 1px solid var(--line); border-radius: 8px; background: var(--surface); padding: .625rem .75rem; }
  .node b { display: block; font-size: 13.5px; color: var(--text); font-weight: 600; }
  .node small { display: block; margin-top: .125rem; font-size: 12px; color: var(--dim); }
  .accent { border-color: color-mix(in srgb, var(--green) 45%, var(--line)); }
  .edge { border-style: dashed; }
  .arrow { text-align: center; color: var(--dimmer); font-family: var(--font-mono); transform: rotate(90deg); }
  .projects { display: grid; gap: .75rem; margin-top: .5rem; }
  .project { display: grid; gap: .5rem; padding: .75rem; border: 1px solid var(--line); border-radius: 10px; }
  .tag, .route { font-family: var(--font-mono); font-size: 12px; color: var(--brass); }
  .split { display: grid; gap: .5rem; }
  .split > div, .runner { display: grid; gap: .25rem; }
  .split > div { padding-left: .75rem; border-left: 2px solid var(--line); }
  .runner { margin-top: .5rem; }
  .runner .route { color: var(--dimmer); }
  @media (min-width: 720px) {
    .map { grid-template-columns: 1fr auto 1fr; align-items: center; row-gap: 1rem; }
    .arrow { transform: none; }
    .projects { grid-column: 1 / -1; grid-template-columns: 1fr 2fr; align-items: start; }
    .split { grid-template-columns: 1fr 1fr; }
    .runner { grid-column: 1 / -1; }
  }
</style>
