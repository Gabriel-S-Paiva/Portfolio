---
// One bug as an expandable row. Collapsed: what broke and the takeaway. Open: symptom, cause, fix.
// Backticks in the string props render as inline code. Optional slot holds a code block under the fix.
interface Props {
  n: number;
  title: string;
  area: string;
  /** One line a skimmer can take away without opening the row. */
  lesson: string;
  symptom: string;
  cause: string;
  fix: string;
  open?: boolean;
}
const { n, title, area, lesson, symptom, cause, fix, open = false } = Astro.props;
const fmt = (s: string) =>
  s.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/`([^`]+)`/g, '<code>$1</code>');
const panels = [
  { key: 'symptom', label: 'Symptom', text: symptom },
  { key: 'cause', label: 'Cause', text: cause },
  { key: 'fix', label: 'Fix', text: fix },
];
---

<details class="bug" open={open}>
  <summary>
    <span class="num">{String(n).padStart(2, '0')}</span>
    <span class="head">
      <span class="title">{title}</span>
      <span class="lesson" set:html={fmt(lesson)} />
    </span>
    <span class="area">{area}</span>
    <span class="chev" aria-hidden="true"></span>
  </summary>
  <div class="detail">
    <dl class="panels">
      {panels.map((p) => (
        <div class={`panel ${p.key}`}>
          <dt>{p.label}</dt>
          <dd set:html={fmt(p.text)} />
        </div>
      ))}
    </dl>
    <div class="extra"><slot /></div>
  </div>
</details>

<style>
  .bug { border-bottom: 1px solid var(--line); }
  .bug:last-child { border-bottom: 0; }
  summary {
    display: grid; grid-template-columns: 2rem 1fr auto 1rem; gap: .25rem .875rem; align-items: start;
    padding: .875rem 1rem; cursor: pointer; list-style: none;
    transition: background-color .2s cubic-bezier(.16, 1, .3, 1);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { background: color-mix(in srgb, var(--text) 4%, transparent); }
  summary:focus-visible { outline: 2px solid var(--brass); outline-offset: -2px; }
  .num { font-family: var(--font-mono); font-size: 12px; color: var(--brass); padding-top: .2rem; }
  .head { display: grid; gap: .25rem; min-width: 0; }
  .title { font-size: 15px; font-weight: 600; line-height: 1.4; color: var(--text); }
  .lesson { font-size: 13.5px; line-height: 1.5; color: var(--dim); }
  .lesson :global(code), dd :global(code) { font-family: var(--font-mono); font-size: 12.5px; color: var(--text); }
  .area { font-family: var(--font-mono); font-size: 11px; color: var(--dimmer); padding-top: .25rem; white-space: nowrap; }
  .chev {
    width: .5rem; height: .5rem; margin-top: .45rem;
    border-right: 1.5px solid var(--dim); border-bottom: 1.5px solid var(--dim);
    transform: rotate(45deg); transition: transform .25s cubic-bezier(.16, 1, .3, 1);
  }
  .bug[open] .chev { transform: rotate(225deg); margin-top: .65rem; }
  .bug[open] summary { background: color-mix(in srgb, var(--text) 3%, transparent); }

  .detail { padding: .25rem 1rem 1.125rem 3.875rem; }
  .panels { margin: 0; display: grid; gap: .625rem; grid-template-columns: repeat(3, minmax(0, 1fr)); }
  .panel { border-left: 2px solid var(--line); padding: .125rem 0 .125rem .75rem; }
  .panel.cause { border-left-color: var(--brass); }
  .panel.fix { border-left-color: var(--green); }
  dt { font-family: var(--font-mono); font-size: 11px; letter-spacing: .04em; text-transform: uppercase; color: var(--dimmer); }
  .cause dt { color: var(--brass); }
  .fix dt { color: var(--green); }
  dd { margin: .25rem 0 0; font-size: 13.5px; line-height: 1.6; color: var(--dim); }
  .extra:not(:empty) { margin-top: .875rem; }
  .extra :global(pre) { margin: 0; padding: .75rem 1rem; overflow-x: auto; border: 1px solid var(--line); border-radius: 8px; background: var(--surface); font-family: var(--font-mono); font-size: 12.5px; line-height: 1.65; }

  @media (max-width: 767px) {
    summary { grid-template-columns: 2rem 1fr 1rem; }
    .area { grid-column: 2; grid-row: 2; padding-top: 0; }
    .chev { grid-column: 3; grid-row: 1; }
    .detail { padding-left: 1rem; }
    .panels { grid-template-columns: 1fr; }
  }
  /* Smooth open/close. Progressive enhancement: browsers without ::details-content snap instead. */
  @media (prefers-reduced-motion: no-preference) {
    @supports selector(::details-content) {
      .bug { interpolate-size: allow-keywords; }
      .bug::details-content {
        block-size: 0;
        overflow: clip;
        opacity: 0;
        transition:
          block-size .3s cubic-bezier(.16, 1, .3, 1),
          opacity .25s ease,
          content-visibility .3s allow-discrete;
      }
      .bug[open]::details-content { block-size: auto; opacity: 1; }
    }
  }
  @media (prefers-reduced-motion: reduce) {
    summary, .chev { transition: none; }
  }
</style>
