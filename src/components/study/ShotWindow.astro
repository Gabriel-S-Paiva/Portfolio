---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Window from './Window.astro';

// Frame around a real screenshot or design export. Keep images in src/assets/case-studies/<slug>/.
interface Props {
  src: ImageMetadata;
  alt: string;
  title?: string;
  caption?: string;
  /** CSS aspect-ratio, e.g. "16 / 10". Omit to keep the image's own ratio. */
  aspect?: string;
}
const { src, alt, title = 'preview', caption, aspect } = Astro.props;
---

<Window title={title} caption={caption}>
  <Image
    src={src}
    alt={alt}
    widths={[480, 800, 1200]}
    sizes="(min-width: 900px) 844px, 100vw"
    class="shot"
    style={aspect ? `aspect-ratio: ${aspect}; object-fit: cover;` : undefined}
  />
</Window>

<style>
  .shot { display: block; width: 100%; height: auto; }
</style>
